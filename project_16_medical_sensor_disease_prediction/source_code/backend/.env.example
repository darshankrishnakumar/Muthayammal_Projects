# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS URL (comma-separated for multiple allowed origins)
FRONTEND_URL=http://localhost:5173,http://localhost:8080

# Storage Paths (relative to backend root or absolute)
DATABASE_PATH=./storage/medical.db
ECG_STORAGE_PATH=./storage/ecg
REPORTS_STORAGE_PATH=./storage/reports

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# CNN Model Service URL (leave empty until valid CNN model service is configured)
MODEL_SERVICE_URL=
