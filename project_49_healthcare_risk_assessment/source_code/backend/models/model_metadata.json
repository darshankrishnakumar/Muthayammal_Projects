    "weights_path": "backend/models/comorbidity_regressor_weights.pt"
  },
  "dataset": {
    "csv_path": "data/patient_telemetry_6000.csv",
    "total_records": 6000,
    "cohorts": [
      "DIABETIC_METABOLIC",
