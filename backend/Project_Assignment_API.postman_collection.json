            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Quantum Computing Research Portal\",\n  \"description\": \"Platform for quantum algorithm simulations and academic benchmarks.\",\n  \"budget\": 35000.00,\n  \"technologyStack\": \"Python, Qiskit, React, Spring Boot\",\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects"]
            }
          }
        },
