              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "1"]
            }
          }
        },
        {
          "name": "Update Project Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectName\": \"Updated Evaluation Portal\",\n  \"budget\": 18000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "projects", "1"]
            }
          }
        },
