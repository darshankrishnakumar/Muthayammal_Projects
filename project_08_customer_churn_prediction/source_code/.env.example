# ====================================================================
# CUSTOMER CHURN PREDICTION PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# 1. Database Connection (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telecom_churn
DB_USER=root
DB_PASSWORD=

# Optional full JDBC URL override (if using managed cloud MySQL like AWS RDS / Azure)
# DB_URL=jdbc:mysql://127.0.0.1:3306/telecom_churn?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Spring Active Profile: 'mysql' (default) or 'h2' (embedded fallback)
SPRING_PROFILES_ACTIVE=mysql

# 2. Python ML Inference Service Configuration
ML_SERVICE_URL=http://127.0.0.1:8000

# 3. Frontend & CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080/api
