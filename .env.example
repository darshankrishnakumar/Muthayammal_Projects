# ==============================================================================
# Frontend Environment Configuration (.env)
# ==============================================================================

# Public URL of your Spring Boot backend (Local or Tunnel URL)
# Example for local development:
# VITE_API_URL=http://localhost:8080

# Example for Vercel production split-hosting with ngrok / Cloudflare Tunnel:
# VITE_API_URL=https://your-tunnel-subdomain.ngrok-free.app
# VITE_API_URL=https://your-domain.trycloudflare.com

VITE_API_URL=http://localhost:8080

# Set to 'false' to ensure real database/backend requests are used
VITE_MOCK_MODE=false
